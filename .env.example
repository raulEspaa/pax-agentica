# What .env holds. `make env` writes a real one with random secrets; .env is never committed.

# The rulers' database (make db)
PAX_DB_PASSWORD=

# Langfuse: signing in at http://localhost:3000 (make langfuse)
LANGFUSE_USER_EMAIL=raul@pax.local
LANGFUSE_USER_PASSWORD=

# Langfuse: the keys our code will send traces with
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Langfuse: its own services
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_ENCRYPTION_KEY=

# Gemini, for the AI rulers: https://aistudio.google.com/apikey (add it by hand)
GEMINI_API_KEY=
